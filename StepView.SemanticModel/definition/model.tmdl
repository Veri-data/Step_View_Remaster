model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 00_STAGE

	annotation PBI_QueryGroupOrder = 0

queryGroup 01_DIM

	annotation PBI_QueryGroupOrder = 1

queryGroup 02_FACT

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Project","Project_Task","Resource_assignment","Resource","Project_bucket","Project_checklist","Project_label","Project_sprint","project_task_dependency","Project_task_to_label","Project_team","System_user","fait_checklist","fait_assignment","fait_equipe","pont_tache_etiquette","EnvURL","ModeleURLProjet","fnParis","Indicateur_couleur","Label","dim_task_dependency","dim_Task","dim_resource","dim_projet","dim_sprint","dim_etiquette"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

ref table dim_Task
ref table fait_checklist
ref table fait_assignment
ref table dim_resource
ref table dim_projet
ref table dim_date
ref table dim_sprint
ref table dim_etiquette
ref table fait_equipe
