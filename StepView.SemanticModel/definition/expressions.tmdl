expression fnParis =
		let
		    Source = (dt as any) as nullable datetime =>
		    if dt = null then null
		    else
		        let
		            utc = if Value.Is(dt, type datetimezone)
		                  then DateTimeZone.RemoveZone(DateTimeZone.ToUtc(dt))
		                  else DateTime.From(dt),
		            y = Date.Year(utc),
		            debutEte = DateTime.From(Date.StartOfWeek(#date(y, 3, 31), Day.Sunday))  + #duration(0,1,0,0),
		            finEte   = DateTime.From(Date.StartOfWeek(#date(y, 10, 31), Day.Sunday)) + #duration(0,1,0,0),
		            decalage = if utc >= debutEte and utc < finEte then 2 else 1
		        in
		            utc + #duration(0, decalage, 0, 0)
		in
		    Source
	lineageTag: 2e2e89e1-0837-4f8d-bfa3-e4b1fc53fd7c

	annotation PBI_ResultType = Function

