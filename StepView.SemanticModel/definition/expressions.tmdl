expression Project_label =
		let
		    Source = CommonDataService.Database(
		        EnvURL,
		        [CreateNavigationProperties = null]
		    ),
		
		    Labels = Source{[
		        Schema = "dbo",
		        Item = "msdyn_projectlabel"
		    ]}[Data],
		
		    Garder = Table.SelectColumns(
		        Labels,
		        {
		            "msdyn_projectlabelid",
		            "msdyn_projectlabeltext",
		            "msdyn_colorindexname",
		            "msdyn_colorindex",
		            "msdyn_projectid"
		        },
		        MissingField.Ignore
		    ),
		
		    NettoyerCouleur = Table.TransformColumns(
		        Garder,
		        {
		            {
		                "msdyn_colorindexname",
		                each
		                    if _ = null then
		                        null
		                    else
		                        Text.Trim(
		                            Text.Replace(
		                                Text.From(_),
		                                Character.FromNumber(160),
		                                " "
		                            )
		                        ),
		                type text
		            }
		        }
		    )
		in
		    NettoyerCouleur
