	/// Approximation : date d'achèvement = dernière modification d'une tâche du projet.
	measure 'Terminés dans les délais' =
			VAR _termines = CALCULATETABLE ( dim_projet, KEEPFILTERS ( dim_projet[Statut] = "Terminé" ) )
			RETURN
			    COUNTROWS (
			        FILTER (
			            _termines,
			            VAR _fin = dim_projet[Fin]
			            VAR _achevement = CALCULATE ( MAX ( dim_Task[Modifié le] ) )
			            RETURN NOT ISBLANK ( _fin ) && NOT ISBLANK ( _achevement ) && INT ( _achevement ) <= _fin
			        )
			    ) + 0
		formatString: 0
		displayFolder: 1 · Nos projets
		lineageTag: 0b53fcfd-2196-4f48-9377-ea8960551f3f

	measure '% Dans les délais' = DIVIDE ( [Terminés dans les délais], [Projets terminés] )
		formatString: 0.0 %
