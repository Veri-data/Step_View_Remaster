	measure 'Charge mensuelle (h)' =
			VAR _d1 = MIN ( dim_date[Date] )
			VAR _d2 = MAX ( dim_date[Date] )
			VAR _aff = CALCULATETABLE ( fait_assignment, REMOVEFILTERS ( dim_date ) )
			RETURN
			    IF (
			        NOT ISEMPTY ( _aff ),
			        SUMX (
			            _aff,
			            VAR _deb = fait_assignment[Début]
			            VAR _fin = fait_assignment[Fin]
			            VAR _charge = CALCULATE ( [Charge affectation (h)], REMOVEFILTERS ( dim_date ) )
			            VAR _jours = NETWORKDAYS ( _deb, _fin )
			            VAR _a = IF ( _deb > _d1, _deb, _d1 )
			            VAR _b = IF ( _fin < _d2, _fin, _d2 )
			            VAR _jFen = IF ( _a > _b, 0, NETWORKDAYS ( _a, _b ) )
			            RETURN
			                IF ( _jours > 0, DIVIDE ( _charge * _jFen, _jours ), IF ( _deb >= _d1 && _deb <= _d2, _charge, 0 ) )
			        ) + 0
			    )
		formatString: #,##0;-#,##0;"–"
		displayFolder: 2 · Nos ressources
		lineageTag: f4ec6c94-7e84-492a-b347-5ec08e2f42b5

	measure 'Seuil surcharge (h)' = 160
