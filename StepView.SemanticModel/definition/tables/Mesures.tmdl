	measure 'Barre achèvement ressource' =
			VAR _p = MIN ( MAX ( [% Achèvement ressource], 0 ), 1 )
			VAR _graisse = IF ( ISINSCOPE ( dim_projet[Projet] ), "400", "600" )
			RETURN
			    IF (
			        NOT ISBLANK ( [Volume total (h)] ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='24' viewBox='0 0 150 24'>"
			            & "<rect x='0' y='9' width='104' height='6' rx='3' fill='%23E9EEEB'/>"
			            & IF ( _p > 0, "<rect x='0' y='9' width='" & MAX ( INT ( _p * 104 ), 6 ) & "' height='6' rx='3' fill='%23009043'/>" )
			            & "<text x='150' y='16' text-anchor='end' font-family='Segoe UI' font-size='12.5' font-weight='" & _graisse & "' fill='%2316261F'>"
			            & FORMAT ( _p * 100, "0" ) & " %25</text>"
			            & "</svg>"
			    )
		displayFolder: 2 · Nos ressources\Matrice
		lineageTag: 3bd3b9d5-1661-440a-a765-afcc5003d450
		dataCategory: ImageUrl

