	measure 'Répartition volume (svg)' =
			VAR _r = [Volume réalisé (h)] + 0
			VAR _c = [Volume en cours (h)] + 0
			VAR _s = [Volume restant (h)] + 0
			VAR _tot = _r + _c + _s
			VAR _w = 604
			VAR _g = 4
			VAR _b1 = IF ( _tot > 0, INT ( _r / _tot * _w + 0.5 ), 0 )
			VAR _b2 = IF ( _tot > 0, INT ( ( _r + _c ) / _tot * _w + 0.5 ), 0 )
			VAR _blocs =
			    DATATABLE (
			        "Ordre", INTEGER, "Libelle", STRING, "Couleur", STRING,
			        {
			            { 0, "Réalisé", "%2300734E" },
			            { 1, "En cours (reste à faire)", "%233F86C8" },
			            { 2, "Restant (non démarré)", "%23B4BFB9" }
			        }
			    )
			VAR _libelles =
			    CONCATENATEX (
			        _blocs,
			        VAR _x = [Ordre] * 208
			        VAR _h = SWITCH ( [Ordre], 0, _r, 1, _c, _s )
			        RETURN
			            "<rect x='" & _x + 1 & "' y='5' width='9' height='9' rx='2' fill='" & [Couleur] & "'/>"
			                & "<text x='" & _x + 15 & "' y='14' font-family='Segoe UI' font-size='14' fill='%234E5D55'>" & [Libelle] & "</text>"
			                & "<text x='" & _x + 1 & "' y='38' font-family='Segoe UI' font-size='18' font-weight='700' fill='%2316261F'>"
			                & FORMAT ( _h, "#,##0" ) & " h<tspan dx='5' font-size='12' font-weight='400' fill='%2366736C'>"
			                & FORMAT ( DIVIDE ( _h, _tot ) * 100 + 0, "0.0" ) & " %25</tspan></text>",
			        "",
			        [Ordre], ASC
			    )
			// 100 % bar: one rounded segment per non-empty volume, 4 px gap between segments
			VAR _seg1 = IF ( _b1 > 0, "<rect x='0' y='54' width='" & MAX ( _b1 - IF ( _b1 < _w, _g, 0 ), 2 ) & "' height='10' rx='5' fill='%2300734E'/>" )
			VAR _seg2 = IF ( _b2 > _b1, "<rect x='" & _b1 & "' y='54' width='" & MAX ( _b2 - _b1 - IF ( _b2 < _w, _g, 0 ), 2 ) & "' height='10' rx='5' fill='%233F86C8'/>" )
			VAR _seg3 = IF ( _w > _b2 && _tot > 0, "<rect x='" & _b2 & "' y='54' width='" & MAX ( _w - _b2, 2 ) & "' height='10' rx='5' fill='%23B4BFB9'/>" )
			VAR _vide = IF ( _tot = 0, "<rect x='0' y='54' width='604' height='10' rx='5' fill='%23E9EEEB'/>" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='604' height='68' viewBox='0 0 604 68'>"
			        & _libelles & _vide & _seg1 & _seg2 & _seg3
			        & "</svg>"
		displayFolder: 2 · Nos ressources\Visuels
		lineageTag: e35c0444-8242-406c-82e2-e6ede55d1800
		dataCategory: ImageUrl

