	measure 'Libellé actualisation' =
			VAR _d = MAX ( Actualisation[Date] )
			RETURN "Actualisé le " & FORMAT ( _d, "dd/mm/yyyy" ) & " à " & FORMAT ( _d, "hh:nn" )
		displayFolder: 1 · Nos projets\Sous-titres
