	/// Travail achevé : heures réalisées / heures planifiées des tâches de travail (guide DAX). Avancement Planner si aucune heure n'est planifiée.
	measure 'Avancement projet' =
			VAR _plan = [Charge planifiée (h)]
			RETURN
			    IF (
			        NOT ISBLANK ( [Nb projets] ),
			        IF ( _plan > 0, DIVIDE ( [Charge réalisée (h)], _plan ), AVERAGE ( dim_projet[Avancement] ) )
			    )
		formatString: 0 %
		displayFolder: 1 · Nos projets
		lineageTag: efe8c596-d8a7-4ad2-b901-2c8e56bf3213

	/// Travail achevé du portefeuille : heures réalisées / heures planifiées (guide DAX). Avancement Planner si aucune heure n'est planifiée.
	measure 'Avancement global' =
			VAR _plan = [Charge planifiée (h)]
			RETURN
			    IF (
			        NOT ISBLANK ( [Nb projets] ),
			        IF ( _plan > 0, DIVIDE ( [Charge réalisée (h)], _plan ), AVERAGE ( dim_projet[Avancement] ) )
			    )
		formatString: 0.0 %
		displayFolder: 1 · Nos projets
		lineageTag: 4bc9ceee-866b-4bee-8aae-afd0daf713c0

	measure '% Délai consommé' =
			VAR _debut = MIN ( dim_projet[Début] )
			VAR _fin = MAX ( dim_projet[Fin] )
			VAR _total = DATEDIFF ( _debut, _fin, DAY )
			VAR _ecoule = DATEDIFF ( _debut, MIN ( TODAY (), _fin ), DAY )
			RETURN IF ( _total > 0, DIVIDE ( MAX ( 0, _ecoule ), _total ) )
		formatString: 0 %
		displayFolder: 1 · Nos projets
		lineageTag: d65509d4-1c6f-4c7e-81c5-a8506f5729ca

