	measure '% Achèvement' =
			SWITCH (
			    TRUE (),
			    ISINSCOPE ( dim_Task[Tâche] ),
			        CALCULATE ( AVERAGE ( dim_Task[Avancement] ), CROSSFILTER ( fait_assignment[TacheId], dim_Task[TacheId], BOTH ) ),
			    ISINSCOPE ( dim_projet[Projet] ), [Avancement projet],
