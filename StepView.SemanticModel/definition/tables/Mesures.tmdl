	measure 'Légende statuts' =
			VAR _total = [Nb projets]
			VAR _statuts =
			    DATATABLE (
			        "Ordre", INTEGER, "Statut", STRING, "Couleur", STRING,
			        {
			            { 1, "En retard", "%23EF5B3A" },
			            { 2, "En cours", "%233F86C8" },
			            { 3, "Pas commencé", "%23B4BFB9" },
			            { 4, "Terminé", "%2300734E" }
			        }
			    )
			VAR _lignes =
			    CONCATENATEX (
			        _statuts,
			        VAR _y = ( [Ordre] - 1 ) * 44
			        VAR _s = [Statut]
			        VAR _n = CALCULATE ( [Nb projets], KEEPFILTERS ( dim_projet[Statut] = _s ) ) + 0
			        RETURN
			            "<rect x='0' y='" & _y + 4 & "' width='10' height='10' rx='2' fill='" & [Couleur] & "'/>"
			                & "<text x='21' y='" & _y + 14 & "' font-family='Segoe UI' font-size='15' font-weight='600' fill='%2316261F'>" & _s & "</text>"
			                & "<text x='21' y='" & _y + 32 & "' font-family='Segoe UI' font-size='14' fill='%2366736C'>"
			                & "<tspan font-weight='700' fill='%2316261F'>" & _n & "</tspan>" & IF ( _n > 1, " projets", " projet" )
			                & " · " & FORMAT ( DIVIDE ( _n, _total ) * 100 + 0, "0.0" ) & " %25</text>",
			        "",
			        [Ordre], ASC
			    )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='176' viewBox='0 0 180 176'>"
			        & _lignes & "</svg>"
		displayFolder: 1 · Nos projets\Visuels
		lineageTag: b1427d29-d99f-4942-9789-b0e8b4bd0f49
		dataCategory: ImageUrl

	measure 'Graphique chefs' =
			VAR _base =
			    FILTER ( ADDCOLUMNS ( VALUES ( dim_projet[Chef de projet] ), "@n", [Nb projets] ), [@n] > 0 )
			VAR _top = TOPN ( 5, _base, [@n], DESC, dim_projet[Chef de projet], ASC )
			VAR _max = MAXX ( _top, [@n] )
			VAR _x0 = 178
			VAR _w = 285
			VAR _rang =
			    ADDCOLUMNS (
			        _top,
			        "@r",
			            VAR _n0 = [@n]
			            VAR _c0 = dim_projet[Chef de projet]
			            RETURN COUNTROWS ( FILTER ( _top, [@n] > _n0 || ( [@n] = _n0 && dim_projet[Chef de projet] < _c0 ) ) ) + 1
			    )
			VAR _lignes =
			    CONCATENATEX (
			        _rang,
			        VAR _cy = 30 + ( [@r] - 1 ) * 36
			        VAR _c = dim_projet[Chef de projet]
			        VAR _nomBrut = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c, "&", "et" ), "<", "" ), "#", "" )
			        VAR _nom = IF ( LEN ( _nomBrut ) > 17, LEFT ( _nomBrut, 16 ) & "…", _nomBrut )
			        VAR _sp = SEARCH ( " ", _c, 1, 0 )
			        VAR _ini = UPPER ( LEFT ( _c, 1 ) & IF ( _sp > 0, MID ( _c, _sp + 1, 1 ) ) )
			        VAR _n1 = CALCULATE ( [Nb projets], KEEPFILTERS ( dim_projet[Chef de projet] = _c ), KEEPFILTERS ( dim_projet[Statut] = "En retard" ) ) + 0
			        VAR _n2 = CALCULATE ( [Nb projets], KEEPFILTERS ( dim_projet[Chef de projet] = _c ), KEEPFILTERS ( dim_projet[Statut] = "En cours" ) ) + 0
			        VAR _n3 = CALCULATE ( [Nb projets], KEEPFILTERS ( dim_projet[Chef de projet] = _c ), KEEPFILTERS ( dim_projet[Statut] = "Pas commencé" ) ) + 0
			        VAR _n4 = CALCULATE ( [Nb projets], KEEPFILTERS ( dim_projet[Chef de projet] = _c ), KEEPFILTERS ( dim_projet[Statut] = "Terminé" ) ) + 0
			        VAR _w1 = INT ( _n1 / _max * _w )
			        VAR _w2 = INT ( _n2 / _max * _w )
			        VAR _w3 = INT ( _n3 / _max * _w )
			        VAR _w4 = INT ( _n4 / _max * _w )
			        VAR _x2 = _x0 + _w1
			        VAR _x3 = _x2 + _w2
			        VAR _x4 = _x3 + _w3
			        VAR _yb = _cy - 10
			        VAR _seg1 = IF ( _n1 > 0, "<rect x='" & _x0 & "' y='" & _yb & "' width='" & MAX ( _w1 - 4, 2 ) & "' height='19' rx='4' fill='%23EF5B3A'/>" )
			        VAR _seg2 = IF ( _n2 > 0, "<rect x='" & _x2 & "' y='" & _yb & "' width='" & MAX ( _w2 - 4, 2 ) & "' height='19' rx='4' fill='%233F86C8'/>" )
			        VAR _seg3 = IF ( _n3 > 0, "<rect x='" & _x3 & "' y='" & _yb & "' width='" & MAX ( _w3 - 4, 2 ) & "' height='19' rx='4' fill='%23B4BFB9'/>" )
			        VAR _seg4 = IF ( _n4 > 0, "<rect x='" & _x4 & "' y='" & _yb & "' width='" & MAX ( _w4 - 4, 2 ) & "' height='19' rx='4' fill='%2300734E'/>" )
			        RETURN
			            "<circle cx='17' cy='" & _cy & "' r='15' fill='%2300734E'/>"
			                & "<text x='17' y='" & _cy + 4 & "' text-anchor='middle' font-family='Segoe UI' font-size='10.5' font-weight='700' fill='white'>" & _ini & "</text>"
			                & "<text x='40' y='" & _cy + 5 & "' font-family='Segoe UI' font-size='14' font-weight='600' fill='%2316261F'>" & _nom & "</text>"
			                & _seg1 & _seg2 & _seg3 & _seg4
			                & "<text x='504' y='" & _cy + 5 & "' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='700' fill='%2316261F'>" & [@n] & "</text>",
			        "",
			        [@r], ASC
			    )
			VAR _legende =
			    "<g font-family='Segoe UI' font-size='12' fill='%234E5D55'>"
			        & "<rect x='3' y='218' width='9' height='9' rx='2' fill='%23EF5B3A'/><text x='18' y='227'>En retard</text>"
			        & "<rect x='81' y='218' width='9' height='9' rx='2' fill='%233F86C8'/><text x='96' y='227'>En cours</text>"
			        & "<rect x='165' y='218' width='9' height='9' rx='2' fill='%23B4BFB9'/><text x='180' y='227'>Pas commencé</text>"
			        & "<rect x='277' y='218' width='9' height='9' rx='2' fill='%2300734E'/><text x='292' y='227'>Terminé</text></g>"
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='520' height='232' viewBox='0 0 520 232'>"
			        & _lignes & _legende & "</svg>"
		displayFolder: 1 · Nos projets\Visuels
		lineageTag: 87553869-6693-4eb6-93d8-011ccf963086
		dataCategory: ImageUrl

	measure 'Barre avancement' =
			VAR _av = MIN ( MAX ( [Avancement projet], 0 ), 1 )
			VAR _delai = [% Délai consommé]
			VAR _couleur = SUBSTITUTE ( [Couleur statut], "#", "%23" )
			RETURN
			    IF (
			        ISINSCOPE ( dim_projet[Projet] ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='430' height='18' viewBox='0 0 430 18'>"
			            & "<rect x='0' y='4' width='430' height='10' rx='5' fill='%23E9EEEB'/>"
			            & IF ( _av > 0, "<rect x='0' y='4' width='" & MAX ( INT ( _av * 430 ), 10 ) & "' height='10' rx='5' fill='" & _couleur & "'/>" )
			            & IF ( NOT ISBLANK ( _delai ), "<rect x='" & INT ( MIN ( _delai, 1 ) * 428 ) & "' y='0' width='2' height='18' rx='1' fill='%2316261F'/>" )
			            & "</svg>"
			    )
		displayFolder: 1 · Nos projets\Visuels
		lineageTag: 4e267e97-deeb-4f87-9cb3-abff7840a446
		dataCategory: ImageUrl

	measure 'Barre achèvement' =
			VAR _p = MIN ( MAX ( [% Achèvement], 0 ), 1 )
			VAR _statut = [Statut ligne]
			VAR _couleur = SWITCH ( _statut, "En cours", "%233F86C8", "En retard", "%23EF5B3A", "Terminé", "%2300734E", "%23B4BFB9" )
			VAR _graisse = IF ( ISINSCOPE ( dim_Task[Tâche] ), "400", "600" )
			RETURN
			    IF (
			        NOT ISBLANK ( _statut ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='24' viewBox='0 0 150 24'>"
			            & "<rect x='0' y='9' width='104' height='6' rx='3' fill='%23E9EEEB'/>"
			            & IF ( _p > 0, "<rect x='0' y='9' width='" & MAX ( INT ( _p * 104 ), 6 ) & "' height='6' rx='3' fill='" & _couleur & "'/>" )
			            & "<text x='150' y='16' text-anchor='end' font-family='Segoe UI' font-size='12.5' font-weight='" & _graisse & "' fill='%2316261F'>"
			            & FORMAT ( _p * 100, "0" ) & " %25</text>"
			            & "</svg>"
			    )
		displayFolder: 1 · Nos projets\Matrice
		lineageTag: fc6b3514-6434-4802-ad90-c9ef65610368
		dataCategory: ImageUrl

	measure 'Statut ligne' =
			IF (
			    ISINSCOPE ( dim_Task[Tâche] ),
			    CALCULATE (
			        SELECTEDVALUE ( dim_Task[Statut] ),
			        CROSSFILTER ( fait_assignment[TacheId], dim_Task[TacheId], BOTH )
			    ),
			    SELECTEDVALUE ( dim_projet[Statut] )
			)
		isHidden
		displayFolder: 1 · Nos projets\Matrice
		lineageTag: a442a0d7-21d7-4d4d-b863-3939a3c40ffe

	measure 'Icône statut' =
			VAR _statut = [Statut ligne]
			VAR _fond = SWITCH ( _statut, "En cours", "%23E6F0FA", "En retard", "%23FDEAE5", "Pas commencé", "%23EEF1EF", "Terminé", "%23E1F2E8" )
			VAR _encre = SWITCH ( _statut, "En cours", "%231F5F99", "En retard", "%23A93218", "Pas commencé", "%2356635C", "Terminé", "%2300673F" )
			VAR _largeur = SWITCH ( _statut, "En cours", 86, "En retard", 90, "Pas commencé", 122, "Terminé", 84, 100 )
			VAR _icone =
			    SWITCH (
			        _statut,
			        "En retard", "<path d='M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z'/><path d='M12 9v4M12 17h.01'/>",
			        "Terminé", "<circle cx='12' cy='12' r='9'/><path d='m8.5 12.5 2.5 2.5 5-5.5'/>",
			        "En cours", "<circle cx='12' cy='12' r='9'/><path d='M12 3a9 9 0 0 1 0 18z' fill='" & _encre & "'/>",
			        "<circle cx='12' cy='12' r='9' stroke-dasharray='3.5 3'/>"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _statut ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='24' viewBox='0 0 150 24'>"
			            & "<rect width='" & _largeur & "' height='24' rx='12' fill='" & _fond & "'/>"
			            & "<g transform='translate(10 5.5) scale(0.5417)' fill='none' stroke='" & _encre & "' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'>"
			            & _icone & "</g>"
			            & "<text x='29' y='16' font-family='Segoe UI' font-size='12' font-weight='700' fill='" & _encre & "'>" & _statut & "</text>"
			            & "</svg>"
			    )
		displayFolder: 1 · Nos projets\Matrice
		lineageTag: a4120d3a-814a-4e87-9d1f-0f259260b09d
		dataCategory: ImageUrl

	measure 'URL projet (matrice)' =
			IF (
			    ISINSCOPE ( dim_projet[Projet] ) && NOT ISINSCOPE ( dim_Task[Tâche] ),
			    SELECTEDVALUE ( dim_projet[Lien projet] )
