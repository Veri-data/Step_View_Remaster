	measure 'Ressources en surcharge' =
			VAR _mois =
			    CALCULATETABLE (
			        VALUES ( dim_date[Début de mois] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[Décalage mois] >= 0,
			        dim_date[Décalage mois] <= 5
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            CALCULATETABLE ( VALUES ( dim_resource[RessourceId] ), fait_assignment ),
			            MAXX (
			                _mois,
			                VAR _m = dim_date[Début de mois]
			                RETURN CALCULATE ( [Charge mensuelle (h)], REMOVEFILTERS ( dim_date ), dim_date[Début de mois] = _m )
			            ) > [Seuil surcharge (h)]
			        )
			    ) + 0
		formatString: 0
		displayFolder: 2 · Nos ressources
		lineageTag: 9cfa0ec5-b3c7-46c7-a2d7-f640e34f7d0d

