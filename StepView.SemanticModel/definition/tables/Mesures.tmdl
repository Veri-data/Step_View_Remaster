	measure 'KPI fins trimestre (svg)' =
			VAR _valeur = FORMAT ( [Fins prévues au trimestre], "0" )
			VAR _unite = ""
			VAR _couleur = "%2316261F"
			VAR _gras = ""
			VAR _apres = VAR _ref = [Date de référence]
			    VAR _deb = DATE ( YEAR ( _ref ), ( QUARTER ( _ref ) - 1 ) * 3 + 1, 1 )
			    VAR _l = CONCATENATEX ( TOPN ( 4, FILTER ( dim_projet, dim_projet[Fin] >= _deb && dim_projet[Fin] <= EOMONTH ( _deb, 2 ) ), dim_projet[Fin], ASC ),
			                            FORMAT ( dim_projet[Fin], "dd/mm" ), " · ", dim_projet[Fin], ASC )
			    RETURN IF ( _l = "", "aucune fin prévue ce trimestre", _l )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='190' height='52' viewBox='0 0 190 52'>"
			        & "<text x='1' y='27' font-family='Segoe UI' font-size='27' font-weight='700' fill='" & _couleur & "'>" & _valeur
			        & "<tspan dx='3' font-size='16' font-weight='600' fill='%234E5D55'>" & _unite & "</tspan></text>"
			        & "<text x='1' y='46' font-family='Segoe UI' font-size='11.5' fill='%2366736C'><tspan font-weight='700' fill='%2316261F'>" & _gras & "</tspan>" & _apres & "</text>"
