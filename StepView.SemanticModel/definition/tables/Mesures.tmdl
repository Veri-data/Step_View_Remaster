	measure 'Liste échéances (svg)' =
			VAR _jours = 60
			VAR _ref = [Date de référence]
			VAR _ev =
			    UNION (
			        SELECTCOLUMNS ( FILTER ( dim_projet, dim_projet[Début] >= _ref && dim_projet[Début] <= _ref + _jours ),
			            "Date", dim_projet[Début], "Type", "Démarrage", "Projet", dim_projet[Projet], "Chef", dim_projet[Chef de projet] ),
			        SELECTCOLUMNS ( FILTER ( dim_projet, dim_projet[Fin] >= _ref && dim_projet[Fin] <= _ref + _jours ),
			            "Date", dim_projet[Fin], "Type", "Fin du projet", "Projet", dim_projet[Projet], "Chef", dim_projet[Chef de projet] ),
			        SELECTCOLUMNS ( FILTER ( dim_Task, dim_Task[Jalon] = TRUE () && dim_Task[Échéance] >= _ref && dim_Task[Échéance] <= _ref + _jours ),
			            "Date", dim_Task[Échéance], "Type", "◆ Jalon : " & dim_Task[Tâche],
			            "Projet", RELATED ( dim_projet[Projet] ), "Chef", RELATED ( dim_projet[Chef de projet] ) )
			    )
			VAR _top = TOPN ( 5, _ev, [Date], ASC, [Projet], ASC )
			VAR _rang =
			    ADDCOLUMNS ( _top, "@r", VAR _d = [Date] VAR _p = [Projet] RETURN COUNTROWS ( FILTER ( _top, [Date] < _d || ( [Date] = _d && [Projet] < _p ) ) ) )
			VAR _lignes =
			    CONCATENATEX (
			        _rang,
			        VAR _y = [@r] * 59
			        VAR _j = INT ( [Date] - _ref )
			        VAR _proche = _j <= 7
			        VAR _c = [Chef]
			        VAR _sp = SEARCH ( " ", _c, 1, 0 )
			        VAR _chef = IF ( _sp > 0, LEFT ( _c, 1 ) & ". " & MID ( _c, _sp + 1, 40 ), _c )
			        VAR _projet = SUBSTITUTE ( SUBSTITUTE ( [Projet], "&", "et" ), "<", "" )
			        VAR _type = SUBSTITUTE ( SUBSTITUTE ( [Type], "&", "et" ), "<", "" )
			        VAR _pill = "J-" & _j
			        VAR _wPill = 14 + LEN ( _pill ) * 7
			        RETURN
			            "<rect x='0' y='" & _y & "' width='44' height='44' rx='10' fill='" & IF ( _proche, "%23FFF0DC", "%23F3F6F4" ) & "'/>"
			                & "<text x='22' y='" & _y + 21 & "' text-anchor='middle' font-family='Segoe UI' font-size='15' font-weight='700' fill='%2316261F'>" & FORMAT ( [Date], "dd" ) & "</text>"
			                & "<text x='22' y='" & _y + 35 & "' text-anchor='middle' font-family='Segoe UI' font-size='9' font-weight='700' fill='" & IF ( _proche, "%238A4500", "%2366736C" ) & "'>" & UPPER ( FORMAT ( [Date], "mmm" ) ) & "</text>"
			                & "<text x='56' y='" & _y + 18 & "' font-family='Segoe UI' font-size='13' font-weight='600' fill='%2316261F'>" & LEFT ( _projet, 34 ) & "</text>"
			                & "<text x='56' y='" & _y + 35 & "' font-family='Segoe UI' font-size='11.5' fill='%2366736C'>" & LEFT ( _type & " · " & _chef, 52 ) & "</text>"
			                & "<rect x='" & 400 - _wPill & "' y='" & _y + 13 & "' width='" & _wPill & "' height='19' rx='9' fill='" & IF ( _proche, "%23FFE6C7", "%23EEF1EF" ) & "'/>"
			                & "<text x='" & 400 - INT ( _wPill / 2 ) & "' y='" & _y + 27 & "' text-anchor='middle' font-family='Segoe UI' font-size='11' font-weight='700' fill='" & IF ( _proche, "%238A4500", "%234E5D55" ) & "'>" & _pill & "</text>"
			                & IF ( [@r] < COUNTROWS ( _top ) - 1, "<rect x='0' y='" & _y + 51 & "' width='400' height='1' fill='%23EEF2EF'/>" ),
			        "",
			        [@r], ASC
			    )
			// nothing within 60 days: say so, and give the next known event
			VAR _jours2 = 3650
			VAR _suivant = TOPN ( 1, UNION (
			        SELECTCOLUMNS ( FILTER ( dim_projet, dim_projet[Début] > _ref ), "Date", dim_projet[Début], "Type", "démarrage", "Projet", dim_projet[Projet] ),
			        SELECTCOLUMNS ( FILTER ( dim_projet, dim_projet[Fin] > _ref ), "Date", dim_projet[Fin], "Type", "fin", "Projet", dim_projet[Projet] ),
			        SELECTCOLUMNS ( FILTER ( dim_Task, dim_Task[Jalon] = TRUE () && dim_Task[Échéance] > _ref ), "Date", dim_Task[Échéance], "Type", "jalon", "Projet", RELATED ( dim_projet[Projet] ) ) ),
			    [Date], ASC )
			VAR _vide =
			    "<text x='0' y='20' font-family='Segoe UI' font-size='13' font-weight='600' fill='%2316261F'>Aucune échéance dans les 60 prochains jours</text>"
			        & IF ( NOT ISEMPTY ( _suivant ),
			            "<text x='0' y='40' font-family='Segoe UI' font-size='11.5' fill='%2366736C'>Prochaine : "
			                & MAXX ( _suivant, [Type] & " de " & SUBSTITUTE ( SUBSTITUTE ( [Projet], "&", "et" ), "<", "" ) & " le " & FORMAT ( [Date], "dd/mm/yyyy" )
			                    & " (J-" & INT ( [Date] - _ref ) & ")" ) & "</text>" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='300' viewBox='0 0 400 300'>"
			        & IF ( ISEMPTY ( _ev ), _vide, _lignes ) & "</svg>"
		displayFolder: 3 · Timeline\Visuels
		lineageTag: 4805509b-f820-4948-9f2c-6f7648083b59
		dataCategory: ImageUrl

	measure 'Liste retards (svg)' =
			VAR _retards =
			    FILTER ( ADDCOLUMNS ( VALUES ( dim_projet[Projet] ),
			        "@j", CALCULATE ( SUM ( dim_projet[Jours de retard] ) ),
			        "@chef", CALCULATE ( SELECTEDVALUE ( dim_projet[Chef de projet] ) ),
			        "@fin", CALCULATE ( MAX ( dim_projet[Fin] ) ),
			        "@pct", [Avancement projet] ), [@j] > 0 )
			VAR _n = COUNTROWS ( _retards )
			VAR _top = TOPN ( 3, _retards, [@j], DESC, dim_projet[Projet], ASC )
			VAR _rang =
			    ADDCOLUMNS ( _top, "@r", VAR _j0 = [@j] VAR _p0 = dim_projet[Projet] RETURN COUNTROWS ( FILTER ( _top, [@j] > _j0 || ( [@j] = _j0 && dim_projet[Projet] < _p0 ) ) ) )
			VAR _lignes =
			    CONCATENATEX (
			        _rang,
			        VAR _y = [@r] * 54
			        VAR _p = MIN ( MAX ( [@pct], 0 ), 1 )
			        VAR _pill = "+" & FORMAT ( [@j], "0" ) & " j"
			        VAR _wPill = 14 + LEN ( _pill ) * 7
			        VAR _nom = SUBSTITUTE ( SUBSTITUTE ( dim_projet[Projet], "&", "et" ), "<", "" )
			        VAR _chef = SUBSTITUTE ( [@chef], "&", "et" )
			        RETURN
			            "<text x='0' y='" & _y + 13 & "' font-family='Segoe UI' font-size='13' font-weight='600' fill='%2316261F'>" & LEFT ( _nom, 40 ) & "</text>"
			                & "<rect x='" & 400 - _wPill & "' y='" & _y & "' width='" & _wPill & "' height='18' rx='9' fill='%23FDEAE5'/>"
			                & "<text x='" & 400 - INT ( _wPill / 2 ) & "' y='" & _y + 13 & "' text-anchor='middle' font-family='Segoe UI' font-size='11' font-weight='700' fill='%23A93218'>" & _pill & "</text>"
			                & "<text x='0' y='" & _y + 30 & "' font-family='Segoe UI' font-size='11.5' fill='%2366736C'>" & LEFT ( _chef, 30 ) & " · fin prévue le " & FORMAT ( [@fin], "dd/mm/yyyy" ) & "</text>"
			                & "<rect x='0' y='" & _y + 38 & "' width='332' height='7' rx='3' fill='%23FBDCD3'/>"
			                & IF ( _p > 0, "<rect x='0' y='" & _y + 38 & "' width='" & MAX ( INT ( _p * 332 ), 7 ) & "' height='7' rx='3' fill='%23EF5B3A'/>" )
			                & "<text x='400' y='" & _y + 45 & "' text-anchor='end' font-family='Segoe UI' font-size='11.5' font-weight='700' fill='%2316261F'>" & FORMAT ( _p * 100, "0" ) & " %25</text>",
			        "",
			        [@r], ASC
			    )
			VAR _autres = IF ( _n > 3, "<text x='400' y='176' text-anchor='end' font-family='Segoe UI' font-size='11' fill='%2366736C'>+ " & _n - 3 & IF ( _n - 3 > 1, " autres projets en retard", " autre projet en retard" ) & "</text>" )
			VAR _vide = "<text x='0' y='20' font-family='Segoe UI' font-size='13' font-weight='600' fill='%2300734E'>Aucun projet en retard</text>"
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='180' viewBox='0 0 400 180'>"
			        & IF ( _n > 0, _lignes & _autres, _vide ) & "</svg>"
		displayFolder: 3 · Timeline\Visuels
		lineageTag: b01b1f76-4eb3-419f-b91e-811aa9736ad3
		dataCategory: ImageUrl

