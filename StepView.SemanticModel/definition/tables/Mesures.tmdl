	measure 'Fins prévues au trimestre' =
			VAR _ref = [Date de référence]
			VAR _deb = DATE ( YEAR ( _ref ), ( QUARTER ( _ref ) - 1 ) * 3 + 1, 1 )
			VAR _fin = EOMONTH ( _deb, 2 )
			RETURN COUNTROWS ( FILTER ( dim_projet, dim_projet[Fin] >= _deb && dim_projet[Fin] <= _fin ) ) + 0
		formatString: 0
		displayFolder: 3 · Timeline
		lineageTag: 9d121ca9-43ff-47fd-873b-66f406230c56

	measure 'Échéances 60 j' =
			VAR _jours = 60
			VAR _ref = [Date de référence]
			VAR _ev =
			    UNION (
			        SELECTCOLUMNS ( FILTER ( dim_projet, dim_projet[Début] >= _ref && dim_projet[Début] <= _ref + _jours ),
			            "Date", dim_projet[Début], "Type", "Démarrage", "Projet", dim_projet[Projet], "Chef", dim_projet[Chef de projet] ),
			        SELECTCOLUMNS ( FILTER ( dim_projet, dim_projet[Fin] >= _ref && dim_projet[Fin] <= _ref + _jours ),
			            "Date", dim_projet[Fin], "Type", "Fin du projet", "Projet", dim_projet[Projet], "Chef", dim_projet[Chef de projet] ),
			        SELECTCOLUMNS ( FILTER ( dim_Task, dim_Task[Jalon] = TRUE () && dim_Task[Échéance] >= _ref && dim_Task[Échéance] <= _ref + _jours ),
			            "Date", dim_Task[Échéance], "Type", "◆ Jalon : " & dim_Task[Tâche],
			            "Projet", RELATED ( dim_projet[Projet] ), "Chef", RELATED ( dim_projet[Chef de projet] ) )
			    )
			RETURN COUNTROWS ( _ev ) + 0
		formatString: 0
		displayFolder: 3 · Timeline
		lineageTag: 63c467c7-6704-4162-8a49-e225f5ca3891

