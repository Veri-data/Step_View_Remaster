	partition pont_tache_etiquette = m
		mode: import
		queryGroup: 02_FACT
		source =
				let
				    Source = Project_task_to_label,
				    Transformer = Table.TransformColumns(Source, {
				        {"tache_label_id", each Text.Lower(Text.From(_)), type text},
				        {"tache_id",       each if _ = null then null else Text.Lower(Text.From(_)), type text},
				        {"etiquette_id",   each if _ = null then null else Text.Lower(Text.From(_)), type text}
				    }),
				    Renommer = Table.RenameColumns(Transformer, {
				        {"tache_label_id", "TacheEtiquetteId"},
				        {"tache_id",       "TacheId"},
				        {"etiquette_id",   "EtiquetteId"}
				    }),
				    Filtrer = Table.SelectRows(Renommer, each [TacheId] <> null and [EtiquetteId] <> null),
				    SansDoublon = Table.Distinct(Filtrer, {"TacheId", "EtiquetteId"})
				in
				    SansDoublon

	annotation PBI_ResultType = Table

