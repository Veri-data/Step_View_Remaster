		annotation SummarizationSetBy = Automatic

	partition Resource_assignment = m
		mode: import
		queryGroup: 00_STAGE
		source =
				let
				    Source = CommonDataService.Database(EnvURL, [CreateNavigationProperties = null]),
				    Affectations = Source{[Schema = "dbo", Item = "msdyn_resourceassignment"]}[Data],
				    Garder = Table.SelectColumns(Affectations, {
				        "msdyn_resourceassignmentid", "msdyn_bookableresourceid", "msdyn_taskid",
				        "msdyn_projectid", "msdyn_start", "msdyn_finish", "msdyn_plannedwork"
				    }, MissingField.Ignore),
				
				    Renommer = Table.RenameColumns(Garder, {
				        {"msdyn_resourceassignmentid", "AffectationId"},
				        {"msdyn_bookableresourceid",   "RessourceId"},
				        {"msdyn_taskid",               "TacheId"},
				        {"msdyn_projectid",            "ProjetId"},
				        {"msdyn_start",                "Début"},
				        {"msdyn_finish",               "Fin"},
				        {"msdyn_plannedwork",          "Travail planifié (h)"}
				    }),
				
				    // ============ LECTURE DU JSON DE TRAVAIL PLANIFIÉ ============
				    fnHeures = (v as any) as number =>
				        if v = null then 0
				        else if Value.Is(v, type number) then Number.Round(v, 2)
				        else
				            let
				                j     = try Json.Document(Text.From(v)) otherwise null,
				                liste = if j is list then j else if j is record then {j} else {},
				                h     = List.Transform(liste, each
				                            try Number.From(
				                                Record.FieldOrDefault(_, "Hours",
				                                Record.FieldOrDefault(_, "Work", 0)))
				                            otherwise 0)
				            in
				                Number.Round(List.Sum(h) ?? 0, 2),
				
				    // ============ CLÉS + DATES + TRAVAIL ============
				    Transformer = Table.TransformColumns(Renommer, {
				        {"AffectationId", each Text.Lower(Text.From(_)), type text},
				        {"RessourceId",   each if _ = null then null else Text.Lower(Text.From(_)), type text},
				        {"TacheId",       each if _ = null then null else Text.Lower(Text.From(_)), type text},
				        {"ProjetId",      each if _ = null then null else Text.Lower(Text.From(_)), type text},
				        {"Début",         each let d = fnParis(_) in if d = null then null else DateTime.Date(d), type date},
				        {"Fin",           each let d = fnParis(_) in if d = null then null else DateTime.Date(d), type date},
				        {"Travail planifié (h)", fnHeures, type number}
				    }),
				
				    Filtrer = Table.SelectRows(Transformer, each [TacheId] <> null and [RessourceId] <> null)
				in
				    Filtrer

	annotation PBI_ResultType = Table

