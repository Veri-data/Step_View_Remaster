	column 'Lien tâche'
		dataType: string
		lineageTag: 78d43e06-d710-4c6d-9932-cae54910e08b
		summarizeBy: none
		sourceColumn: Lien tâche

		annotation SummarizationSetBy = Automatic

	partition Project_Task = m
		mode: import
		queryGroup: 00_STAGE
		source =
				let
				    // ============ SOURCE ============
				    Source = CommonDataService.Database(EnvURL),
				    Taches = Source{[Schema = "dbo", Item = "msdyn_projecttask"]}[Data],
				
				    // ============ 1. GARDER LES COLONNES UTILES ============
				    Garder = Table.SelectColumns(Taches, {
				        "msdyn_projecttaskid", "msdyn_project", "msdyn_projectbucket", "msdyn_parenttask",
				        "msdyn_subject", "msdyn_description",
				        "msdyn_displaysequence", "msdyn_outlinelevel",
				        "msdyn_scheduledstart", "msdyn_scheduledend",
				        "msdyn_duration", "msdyn_effort", "msdyn_effortcompleted", "msdyn_effortremaining",
				        "msdyn_progress", "msdyn_priority",
				        "msdyn_iscritical", "msdyn_ismilestone", "msdyn_summary",
				        "createdon", "modifiedon"
				    }, MissingField.Ignore),
				
				    // ============ 2. RENOMMER ============
				    Renommer = Table.RenameColumns(Garder, {
				        {"msdyn_projecttaskid",   "TacheId"},
				        {"msdyn_project",         "ProjetId"},
				        {"msdyn_projectbucket",   "BucketId"},
				        {"msdyn_parenttask",      "TacheParenteId"},
				        {"msdyn_subject",         "Tâche"},
				        {"msdyn_description",     "Description"},
				        {"msdyn_displaysequence", "Ordre"},
				        {"msdyn_outlinelevel",    "Niveau"},
				        {"msdyn_scheduledstart",  "DebutUTC"},
				        {"msdyn_scheduledend",    "FinUTC"},
				        {"msdyn_duration",        "Durée (j)"},
				        {"msdyn_effort",          "Effort (h)"},
				        {"msdyn_effortcompleted", "Effort réalisé (h)"},
				        {"msdyn_effortremaining", "Effort restant (h)"},
				        {"msdyn_progress",        "AvancementBrut"},
				        {"msdyn_priority",        "PrioriteCode"},
				        {"msdyn_iscritical",      "Critique"},
				        {"msdyn_ismilestone",     "Jalon"},
				        {"msdyn_summary",         "Récapitulative"},
				        {"createdon",             "CreeLeUTC"},
				        {"modifiedon",            "ModifieLeUTC"}
				    }, MissingField.Ignore),
				
				    // ============ 3. TYPES DES CLÉS (GUID -> texte minuscule) ============
				    Cles = Table.TransformColumns(Renommer, {
				        {"TacheId",        each if _ = null then null else Text.Lower(Text.From(_)), type text},
				        {"ProjetId",       each if _ = null then null else Text.Lower(Text.From(_)), type text},
				        {"BucketId",       each if _ = null then null else Text.Lower(Text.From(_)), type text},
				        {"TacheParenteId", each if _ = null then null else Text.Lower(Text.From(_)), type text}
				    }),
				
				    // ============ 4. NETTOYAGE TEXTE ============
				    Nettoyer = Table.TransformColumns(Cles, {
				        {"Tâche",       each if _ = null or Text.Trim(_) = "" then "(Sans titre)" else Text.Clean(Text.Trim(_)), type text},
				        {"Description", each if _ = null then "" else Text.Clean(Text.Trim(_)), type text}
				    }),
				
				    // ============ 5. NUMÉRIQUES ET BOOLÉENS : null -> valeur par défaut ============
				    Nombres = Table.ReplaceValue(Nettoyer, null, 0, Replacer.ReplaceValue,
				        {"AvancementBrut", "Effort (h)", "Effort réalisé (h)", "Effort restant (h)", "Durée (j)", "Ordre"}),
				    Niveau  = Table.ReplaceValue(Nombres, null, 1, Replacer.ReplaceValue, {"Niveau"}),
				    Bools   = Table.ReplaceValue(Niveau, null, false, Replacer.ReplaceValue, {"Critique", "Jalon", "Récapitulative"}),
				    Types   = Table.TransformColumnTypes(Bools, {
				        {"Ordre", type number}, {"Niveau", Int64.Type},
				        {"Critique", type logical}, {"Jalon", type logical}, {"Récapitulative", type logical}
				    }),
				
				    // ============ 6. DATES UTC -> PARIS ============
				    Debut   = Table.AddColumn(Types,  "Début",      each let d = fnParis([DebutUTC])  in if d = null then null else DateTime.Date(d), type date),
				    Fin     = Table.AddColumn(Debut,  "Échéance",   each let d = fnParis([FinUTC])    in if d = null then null else DateTime.Date(d), type date),
				    Cree    = Table.AddColumn(Fin,    "Créé le",    each let d = fnParis([CreeLeUTC]) in if d = null then null else DateTime.Date(d), type date),
				    Modifie = Table.AddColumn(Cree,   "Modifié le", each fnParis([ModifieLeUTC]), type datetime),
				
				    // ============ 7. AVANCEMENT NORMALISÉ (0 à 1) ============
				    MaxAv      = List.Max(Modifie[AvancementBrut]),
				    Avancement = Table.AddColumn(Modifie, "Avancement", each
				        let v = if MaxAv > 1 then [AvancementBrut] / 100 else [AvancementBrut]
				        in Number.Round(List.Min({List.Max({v, 0}), 1}), 4), Percentage.Type),
				
				    Aujourdhui = DateTime.Date(fnParis(DateTimeZone.UtcNow())),
				
				    // ============ 8. TYPE DE TÂCHE ============
				    TypeTache = Table.AddColumn(Avancement, "Type", each
				        if [Jalon] then "Jalon"
				        else if [Récapitulative] then "Récapitulative"
				        else "Tâche", type text),
				
				    // ============ 9. PRIORITÉ EN CLAIR ============
				    // Échelle Planner : 0-1 Urgente | 2-4 Importante | 5-7 Moyenne | 8-10 Faible
				    Priorite = Table.AddColumn(TypeTache, "Priorité", each
				        let p = [PrioriteCode] in
				        if p = null then "Moyenne"
				        else if p <= 1 then "Urgente"
				        else if p <= 4 then "Importante"
				        else if p <= 7 then "Moyenne"
				        else "Faible", type text),
				
				    PrioriteOrdre = Table.AddColumn(Priorite, "Priorité ordre", each
				        Record.FieldOrDefault([Urgente=1, Importante=2, Moyenne=3, Faible=4], [Priorité], 9), Int64.Type),
				
				    // ============ 10. STATUT ============
				    Statut = Table.AddColumn(PrioriteOrdre, "Statut", each
				        if [Avancement] >= 1                              then "Terminée"
				        else if [Échéance] = null                         then "Non planifiée"
				        else if [Échéance] < Aujourdhui                   then "En retard"
				        else if [Avancement] = 0 and ([Début] = null or [Début] > Aujourdhui) then "Non démarrée"
				        else                                                   "En cours", type text),
				
				    StatutOrdre = Table.AddColumn(Statut, "Statut ordre", each
				        Record.FieldOrDefault([#"Non démarrée"=1, #"En cours"=2, #"En retard"=3, #"Terminée"=4, #"Non planifiée"=5], [Statut], 9),
				        Int64.Type),
				
				    // ============ 11. INDICATEURS DE DÉLAI ============
				    JoursRestants = Table.AddColumn(StatutOrdre, "Jours restants", each
				        if [Échéance] = null or [Statut] = "Terminée" then null
				        else Duration.Days([Échéance] - Aujourdhui), Int64.Type),
				
				    JoursRetard = Table.AddColumn(JoursRestants, "Jours de retard", each
				        if [Statut] = "En retard" then Duration.Days(Aujourdhui - [Échéance]) else 0, Int64.Type),
				
				    Echeance = Table.AddColumn(JoursRetard, "Échéance (catégorie)", each
				        if [Statut] = "Terminée"          then "Terminée"
				        else if [Échéance] = null         then "Sans date"
				        else if [Jours restants] < 0      then "Dépassée"
				        else if [Jours restants] = 0      then "Aujourd'hui"
				        else if [Jours restants] <= 7     then "Cette semaine"
				        else if [Jours restants] <= 30    then "Ce mois-ci"
				        else "Plus tard", type text),
				
				    DureeCal = Table.AddColumn(Echeance, "Durée calendaire (j)", each
				        if [Début] = null or [Échéance] = null then null
				        else Duration.Days([Échéance] - [Début]) + 1, Int64.Type),
				
				    // ============ 12. AFFICHAGE HIÉRARCHIQUE (WBS) ============
				    Indente = Table.AddColumn(DureeCal, "Tâche (indentée)", each
				        Text.Repeat("    ", List.Max({[Niveau] - 1, 0}))
				        & (if [Jalon] then "◆ " else if [Récapitulative] then "▸ " else "")
				        & [Tâche], type text),
				
				    // Nom de la tâche parente (recherche dans la table elle-même)
				    Parents    = Table.Buffer(Table.SelectColumns(Indente, {"TacheId", "Tâche"})),
				    DictParent = Record.FromList(Parents[Tâche], Parents[TacheId]),
				    NomParent  = Table.AddColumn(Indente, "Tâche parente", each
				        if [TacheParenteId] = null then "(Racine)"
				        else Record.FieldOrDefault(DictParent, [TacheParenteId], "(Inconnue)"), type text),
				
				    // Tâche feuille = vraie tâche de travail (à utiliser pour compter les tâches)
				    Feuille = Table.AddColumn(NomParent, "Est tâche de travail", each not [Récapitulative], type logical),
				
				    // ============ 13. LIENS ============
				    LienPlan = Table.AddColumn(Feuille, "Lien plan", each
				        if [ProjetId] = null then null else Text.Replace(ModeleURLProjet, "{id}", [ProjetId]), type text),
				
				    LienTache = Table.AddColumn(LienPlan, "Lien tâche", each
				        EnvURL & "/main.aspx?pagetype=entityrecord&etn=msdyn_projecttask&id=" & [TacheId], type text),
				
				    // ============ 14. SUPPRIMER LES COLONNES TECHNIQUES ============
				    Final = Table.RemoveColumns(LienTache,
				        {"DebutUTC", "FinUTC", "CreeLeUTC", "ModifieLeUTC", "AvancementBrut", "PrioriteCode"},
				        MissingField.Ignore)
				in
				    Final

	annotation PBI_ResultType = Table

