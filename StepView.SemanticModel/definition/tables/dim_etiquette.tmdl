	partition dim_etiquette = m
		mode: import
		queryGroup: 01_DIM
		source =
				let
				    Source = Label,
				    Garder = Table.SelectColumns(Source, {
				        "EtiquetteId", "msdyn_projectid", "Étiquette", "Couleur Name",
				        "colorindex", "Background Color Hex Code", "Text Color Hex Code"
				    }, MissingField.UseNull),
				    Renommer = Table.RenameColumns(Garder, {
				        {"msdyn_projectid",           "ProjetId"},
				        {"Couleur Name",              "Couleur"},
				        {"colorindex",                "Couleur index"},
				        {"Background Color Hex Code", "Couleur fond"},
				        {"Text Color Hex Code",       "Couleur texte"}
				    }),
				    Transformer = Table.TransformColumns(Renommer, {
				        {"EtiquetteId", each Text.Lower(Text.From(_)), type text},
				        {"ProjetId",    each if _ = null then null else Text.Lower(Text.From(_)), type text},
				        {"Étiquette",   each if _ = null or Text.Trim(_) = "" then "(Sans nom)" else Text.Trim(_), type text}
				    }),
				    Types = Table.TransformColumnTypes(Transformer, {
				        {"Couleur", type text}, {"Couleur index", Int64.Type},
				        {"Couleur fond", type text}, {"Couleur texte", type text}
				    }),
				    SansDoublon = Table.Distinct(Types, {"EtiquetteId"})
				in
				    SansDoublon

	annotation PBI_ResultType = Table

