table Project_bucket
	lineageTag: 0fad504a-6f2e-4a8c-a77a-fc994402b4fd

	column 'Compartiment du projet'
		dataType: string
		lineageTag: 97042683-2fd3-4070-8d80-a5105d7559c6
		summarizeBy: none
		sourceColumn: BucketId

		annotation SummarizationSetBy = Automatic

	column Nom
		dataType: string
		lineageTag: 730c83ee-07cd-4cbf-9152-99e71f8f402f
		summarizeBy: none
		sourceColumn: Bucket

		annotation SummarizationSetBy = Automatic

	column msdyn_project
		dataType: string
		lineageTag: d3075ab7-b80b-419f-885a-c4349d1f15a4
		summarizeBy: none
		sourceColumn: ProjetId

		annotation SummarizationSetBy = Automatic

	partition Project_bucket = m
		mode: import
		queryGroup: 00_STAGE
		source =
				let
				    Source = CommonDataService.Database(EnvURL, [CreateNavigationProperties = null]),
				    Buckets = Source{[Schema = "dbo", Item = "msdyn_projectbucket"]}[Data],
				    Garder = Table.SelectColumns(Buckets,
				        {"msdyn_projectbucketid", "msdyn_name", "msdyn_project"}, MissingField.Ignore),
				
				    Renommer = Table.RenameColumns(Garder, {
				        {"msdyn_projectbucketid", "BucketId"},
				        {"msdyn_name",            "Bucket"},
				        {"msdyn_project",         "ProjetId"}
				    }),
				
				    Transformer = Table.TransformColumns(Renommer, {
				        {"BucketId", each Text.Lower(Text.From(_)), type text},
				        {"Bucket",   each if _ = null or Text.Trim(_) = "" then "(Sans nom)" else Text.Trim(_), type text},
				        {"ProjetId", each if _ = null then null else Text.Lower(Text.From(_)), type text}
				    })
				in
				    Transformer

	annotation PBI_ResultType = Table

