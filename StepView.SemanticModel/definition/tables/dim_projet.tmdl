	column 'Durée (j ouvrés)' =
			IF (
			    NOT ISBLANK ( dim_projet[Début] ) && NOT ISBLANK ( dim_projet[Fin] ) && dim_projet[Fin] >= dim_projet[Début],
			    NETWORKDAYS ( dim_projet[Début], dim_projet[Fin] )
			)
		dataType: int64
		formatString: 0
		lineageTag: 3e16cd1e-7a13-4750-80c8-5bc2a1b8febb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Clé de tri' = dim_projet[Statut ordre] * 100000 + INT ( COALESCE ( dim_projet[Fin], DATE ( 2099, 12, 31 ) ) )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: de1c90a1-998d-496e-871c-942ac402e98c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_projet = m
		mode: import
		queryGroup: 01_DIM
		source =
				let
				  Source = Project,
				  Cle = Table.TransformColumns(Source, {{"ProjetId", each Text.Lower(Text.From(_)), type text}}),
				  #"Doublons supprimés" = Table.Distinct(Cle, {"ProjetId"})
				in
				  #"Doublons supprimés"

	annotation PBI_ResultType = Table

