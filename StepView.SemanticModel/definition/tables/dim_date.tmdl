	hierarchy Calendrier
		lineageTag: 3de26070-2b21-403f-b7c5-4f3a05aa1755

		level Année
			lineageTag: 2fc0b09c-c215-4f8d-906e-7bcd8f4b2520
			column: Année

		level Trimestre
			lineageTag: 849c4368-bd2e-4cc0-8346-c4779eb1ba4e
			column: Trimestre

		level Mois
			lineageTag: ff1a6e92-c64c-4622-854e-55cc2848815b
			column: Mois

		level Date
			lineageTag: 195c880e-9233-4b09-a344-1f907a552a48
			column: Date

	partition dim_date = calculated
		mode: import
		source =
				VAR _Bornes =
				    FILTER (
				        {
				            MIN ( dim_Task[Début] ), MAX ( dim_Task[Début] ),
				            MIN ( dim_Task[Échéance] ), MAX ( dim_Task[Échéance] ),
				            MIN ( dim_Task[Créé le] ),
				            MIN ( dim_projet[Début] ), MAX ( dim_projet[Fin] ),
				            MIN ( fait_assignment[Début] ), MAX ( fait_assignment[Fin] ),
				            TODAY ()
				        },
				        NOT ISBLANK ( [Value] )
				    )
				VAR _Debut = DATE ( YEAR ( MINX ( _Bornes, [Value] ) ), 1, 1 )
				VAR _Fin = DATE ( YEAR ( MAXX ( _Bornes, [Value] ) ) + 1, 12, 31 )
				RETURN
				    CALENDAR ( _Debut, _Fin )

