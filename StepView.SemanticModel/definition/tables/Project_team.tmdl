	partition Project_team = m
		mode: import
		queryGroup: 00_STAGE
		source =
				let
				    Source = CommonDataService.Database(EnvURL, [CreateNavigationProperties = null]),
				    Equipe = Source{[Schema = "dbo", Item = "msdyn_projectteam"]}[Data],
				    Garder = Table.SelectColumns(Equipe, {"msdyn_projectteamid", "msdyn_name",
				        "msdyn_bookableresourceid", "msdyn_project", "email"}, MissingField.Ignore),
				
				    Renommer = Table.RenameColumns(Garder, {
				        {"msdyn_projectteamid",      "MembreId"},
				        {"msdyn_name",               "Membre"},
				        {"msdyn_bookableresourceid", "RessourceId"},
				        {"msdyn_project",            "ProjetId"},
				        {"email",                    "EmailEquipe"}
				    }),
				
				    Cles = Table.TransformColumns(Renommer, {
				        {"MembreId",    each Text.Lower(Text.From(_)), type text},
				        {"RessourceId", each if _ = null then null else Text.Lower(Text.From(_)), type text},
				        {"ProjetId",    each if _ = null then null else Text.Lower(Text.From(_)), type text}
				    }),
				  #"Colonnes supprimées" = Table.RemoveColumns(Cles, {"EmailEquipe"})
				in
				    #"Colonnes supprimées"

